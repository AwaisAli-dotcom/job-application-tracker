SECRET_KEY=replace-this-with-a-secure-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Local development uses SQLite when DATABASE_URL is empty.
# Production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=

# Private Cloudflare R2 storage for uploaded application documents.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Production security defaults are enabled when DEBUG=False.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Optional production email backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Console logging level used by the hosting platform.
LOG_LEVEL=INFO
